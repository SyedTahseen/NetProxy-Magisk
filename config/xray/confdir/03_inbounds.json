{
    "inbounds": [
        {
            "tag": "tproxy-in",
            "port": 12345,
            "protocol": "tunnel",
            "settings": {
                "allowedNetwork": "tcp,udp",
                "followRedirect": true,
                "userLevel": 0
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            },
            "streamSettings": {
                "sockopt": {
                    "tproxy": "tproxy"
                }
            }
        },
        {
            "tag": "dns-in",
            "port": 1053,
            "protocol": "tunnel",
            "settings": {
                "rewriteAddress": "1.1.1.1",
                "rewritePort": 53,
                "allowedNetwork": "tcp,udp",
                "userLevel": 0
            }
        }
    ]
}
