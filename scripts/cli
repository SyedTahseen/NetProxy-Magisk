#!/system/bin/sh

#############################################################################
# NetProxy CLI - command-line control tool
# Manage NetProxy through adb shell
#
# Usage: adb shell su -c "/data/adb/modules/netproxy/scripts/cli <command> [args]"
#
# Commands:
#   status                  Show service status
#   start                   Start service
#   stop                    Stop service
#   restart                 Restart service
#
#   config list             List all configs
#   config switch <name>    Switch config (supports hot switch)
#   config current          Show current config
#   config add <link>       Add node
#   config remove <name>    Delete config
#   config show <name>      Show config contents
#
#   sub list                List all subscriptions
#   sub add <name> <URL>    Add subscription
#   sub update <name>       Update the given subscription
#   sub update-all          Update all subscriptions
#   sub remove <name>       Delete subscription
#
#   proxy mode              Show proxy mode
#   proxy mode <mode>       Set proxy mode (blacklist/whitelist)
#   proxy apps              List proxied apps
#   proxy add <package>     Add app to list
#   proxy remove <package>  Remove app from list
#   proxy reload            Reload proxy rules (takes effect immediately)
#
#############################################################################

set -e
set -u

# Path configuration
MODDIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$MODDIR/scripts"
CONFIG_DIR="$MODDIR/config"
OUTBOUNDS_DIR="$CONFIG_DIR/xray/outbounds"
STATUS_FILE="$CONFIG_DIR/status.conf"
PROXY_CONF="$CONFIG_DIR/proxy.conf"
APPS_LIST="$CONFIG_DIR/proxy_apps.list"
XRAY_BIN="$MODDIR/bin/xray"

# Colored output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

#######################################
# Output functions
#######################################
info() {
    printf "${GREEN}[INFO]${NC} %s\n" "$1"
}

warn() {
    printf "${YELLOW}[WARN]${NC} %s\n" "$1"
}

error() {
    printf "${RED}[ERROR]${NC} %s\n" "$1"
    exit 1
}

#######################################
# Check whether Xray is running
#######################################
is_running() {
    pgrep -f "^$XRAY_BIN" >/dev/null 2>&1
}

#######################################
# Service status
#######################################
cmd_status() {
    echo "=============================="
    echo "       NetProxy Status"
    echo "=============================="
    
    # Service status
    if is_running; then
        printf "Service status: ${GREEN}Running${NC}\n"
        
        # Get PID and uptime
        local pid=$(pgrep -f "^$XRAY_BIN" | head -1)
        echo "Process PID: $pid"
        
        # Try to get the uptime
        local uptime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' || echo "--")
        echo "Uptime: $uptime"
        
        # Memory usage
        local mem=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ' || echo "0")
        if [ "$mem" -gt 1024 ] 2>/dev/null; then
            echo "Memory usage: $((mem / 1024)) MB"
        else
            echo "Memory usage: ${mem} KB"
        fi
    else
        printf "Service status: ${RED}Stopped${NC}\n"
    fi
    
    # Current config
    if [ -f "$STATUS_FILE" ]; then
        local config=$(grep '^config=' "$STATUS_FILE" | cut -d'"' -f2)
        if [ -n "$config" ]; then
            echo "Current config: $(basename "$config")"
        fi
    fi
    
    # Proxy mode
    local mode="blacklist"
    if [ -f "$PROXY_CONF" ]; then
        mode=$(grep -E "^proxy_mode=" "$PROXY_CONF" | cut -d'=' -f2 | tr -d ' \r')
    fi
    echo "Proxy mode: $mode"
    
    # Xray version
    if [ -x "$XRAY_BIN" ]; then
        local version=$("$XRAY_BIN" version 2>/dev/null | grep -o 'Xray [0-9.]*' | head -1 || echo "unknown")
        echo "Xray version: $version"
    fi
    
    echo "=============================="
}

#######################################
# Start service
#######################################
cmd_start() {
    if is_running; then
        warn "Service is already running"
        return 0
    fi
    
    # Ensure the log directory exists
    mkdir -p "$MODDIR/logs"
    
    info "Starting service..."
    sh "$SCRIPTS_DIR/core/start.sh"
    
    if is_running; then
        info "Service started successfully"
    else
        error "Service failed to start, please check the logs"
    fi
}

#######################################
# Stop service
#######################################
cmd_stop() {
    if ! is_running; then
        warn "Service is not running"
        return 0
    fi
    
    info "Stopping service..."
    sh "$SCRIPTS_DIR/core/stop.sh"
    
    if ! is_running; then
        info "Service stopped"
    else
        error "Failed to stop service"
    fi
}

#######################################
# Restart service
#######################################
cmd_restart() {
    info "Restarting service..."
    
    if is_running; then
        sh "$SCRIPTS_DIR/core/stop.sh"
        sleep 1
    fi
    
    sh "$SCRIPTS_DIR/core/start.sh"
    
    if is_running; then
        info "Service restarted successfully"
    else
        error "Failed to restart service"
    fi
}

#######################################
# Config management
#######################################
cmd_config() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        list)
            echo "=============================="
            echo "       Config File List"
            echo "=============================="
            
            # Get the current config
            local current=""
            if [ -f "$STATUS_FILE" ]; then
                current=$(grep '^config=' "$STATUS_FILE" | cut -d'"' -f2)
                current=$(basename "$current" 2>/dev/null || echo "")
            fi
            
            # List the default group
            echo ""
            echo "[Default group]"
            for f in "$OUTBOUNDS_DIR"/*.json; do
                [ -f "$f" ] || continue
                local name=$(basename "$f")
                if [ "$name" = "$current" ]; then
                    printf "  ${GREEN}* %s${NC} (current)\n" "$name"
                else
                    echo "    $name"
                fi
            done
            
            # List subscription groups
            for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
                [ -d "$sub_dir" ] || continue
                local meta_file="$sub_dir/_meta.json"
                [ -f "$meta_file" ] || continue
                
                local sub_name=$(grep -o '"name": *"[^"]*"' "$meta_file" | sed 's/"name": *"\([^"]*\)"/\1/')
                echo ""
                echo "[Subscription: $sub_name]"
                
                for f in "$sub_dir"/*.json; do
                    [ -f "$f" ] || continue
                    local name=$(basename "$f")
                    [ "$name" = "_meta.json" ] && continue
                    
                    local full_path="$f"
                    if [ "$full_path" = "$current" ] || [ "$name" = "$current" ]; then
                        printf "  ${GREEN}* %s${NC} (current)\n" "$name"
                    else
                        echo "    $name"
                    fi
                done
            done
            echo ""
            ;;
        
        switch)
            local config_name="${1:-}"
            if [ -z "$config_name" ]; then
                error "Please specify a config name"
            fi
            
            # Find the config file
            local config_path=""
            
            # Look in the default directory first
            if [ -f "$OUTBOUNDS_DIR/$config_name" ]; then
                config_path="$OUTBOUNDS_DIR/$config_name"
            elif [ -f "$OUTBOUNDS_DIR/${config_name}.json" ]; then
                config_path="$OUTBOUNDS_DIR/${config_name}.json"
            else
                # Look in the subscription directories
                for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
                    [ -d "$sub_dir" ] || continue
                    if [ -f "$sub_dir/$config_name" ]; then
                        config_path="$sub_dir/$config_name"
                        break
                    elif [ -f "$sub_dir/${config_name}.json" ]; then
                        config_path="$sub_dir/${config_name}.json"
                        break
                    fi
                done
            fi
            
            if [ -z "$config_path" ]; then
                error "Config not found: $config_name"
            fi
            
            info "Switching config: $(basename "$config_path")"
            
            if is_running; then
                # hot switch
                info "Service is running, performing hot switch..."
                sh "$SCRIPTS_DIR/core/switch-config.sh" "$config_path"
                info "Hot Switch Complete"
            else
                # Update status.conf
                echo "status=\"stopped\"" > "$STATUS_FILE"
                echo "config=\"$config_path\"" >> "$STATUS_FILE"
                info "Config updated, takes effect on next start"
            fi
            ;;
        
        current)
            if [ -f "$STATUS_FILE" ]; then
                local config=$(grep '^config=' "$STATUS_FILE" | cut -d'"' -f2)
                if [ -n "$config" ]; then
                    echo "Current config: $(basename "$config")"
                    echo "Full path: $config"
                else
                    echo "No config set"
                fi
            else
                echo "Status file does not exist"
            fi
            ;;
        
        add)
            local node_link="${1:-}"
            if [ -z "$node_link" ]; then
                error "Please provide a node link"
            fi
            
            info "Parsing node link..."
            chmod +x "$MODDIR/bin/proxylink"
            if "$MODDIR/bin/proxylink" -parse "$node_link" -insecure -format xray -dir "$OUTBOUNDS_DIR" -auto; then
                info "Node added successfully"
            else
                error "Failed to add node"
            fi
            ;;
        
        remove)
            local config_name="${1:-}"
            if [ -z "$config_name" ]; then
                error "Please specify a config name"
            fi
            
            # Find the config file
            local config_path=""
            
            # Look in the default directory first
            if [ -f "$OUTBOUNDS_DIR/$config_name" ]; then
                config_path="$OUTBOUNDS_DIR/$config_name"
            elif [ -f "$OUTBOUNDS_DIR/${config_name}.json" ]; then
                config_path="$OUTBOUNDS_DIR/${config_name}.json"
            else
                # Look in the subscription directories
                for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
                    [ -d "$sub_dir" ] || continue
                    if [ -f "$sub_dir/$config_name" ]; then
                        config_path="$sub_dir/$config_name"
                        break
                    elif [ -f "$sub_dir/${config_name}.json" ]; then
                        config_path="$sub_dir/${config_name}.json"
                        break
                    fi
                done
            fi
            
            if [ -z "$config_path" ]; then
                error "Config not found: $config_name"
            fi
            
            # Check whether this is the config currently in use
            if [ -f "$STATUS_FILE" ]; then
                local current=$(grep '^config=' "$STATUS_FILE" | cut -d'"' -f2)
                if [ "$config_path" = "$current" ]; then
                    error "Cannot delete the config currently in use"
                fi
            fi
            
            rm -f "$config_path"
            info "Deleted config: $(basename "$config_path")"
            ;;
        
        show)
            local config_name="${1:-}"
            if [ -z "$config_name" ]; then
                error "Please specify a config name"
            fi
            
            # Find the config file
            local config_path=""
            
            # Look in the default directory first
            if [ -f "$OUTBOUNDS_DIR/$config_name" ]; then
                config_path="$OUTBOUNDS_DIR/$config_name"
            elif [ -f "$OUTBOUNDS_DIR/${config_name}.json" ]; then
                config_path="$OUTBOUNDS_DIR/${config_name}.json"
            else
                # Look in the subscription directories
                for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
                    [ -d "$sub_dir" ] || continue
                    if [ -f "$sub_dir/$config_name" ]; then
                        config_path="$sub_dir/$config_name"
                        break
                    elif [ -f "$sub_dir/${config_name}.json" ]; then
                        config_path="$sub_dir/${config_name}.json"
                        break
                    fi
                done
            fi
            
            if [ -z "$config_path" ]; then
                error "Config not found: $config_name"
            fi
            
            echo "=============================="
            echo "Config: $(basename "$config_path")"
            echo "Path: $config_path"
            echo "=============================="
            cat "$config_path"
            ;;
        
        *)
            echo "Usage: cli config <command>"
            echo ""
            echo "Commands:"
            echo "  list                List all configs"
            echo "  switch <name>       Switch config"
            echo "  current             Show current config"
            echo "  add <node-link>     Add node"
            echo "  remove <name>       Delete config"
            echo "  show <name>         Show config contents"
            ;;
    esac
}

#######################################
# Subscription management
#######################################
cmd_sub() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        list)
            echo "=============================="
            echo "       Subscription List"
            echo "=============================="
            
            local count=0
            for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
                [ -d "$sub_dir" ] || continue
                local meta_file="$sub_dir/_meta.json"
                [ -f "$meta_file" ] || continue
                
                local name=$(grep -o '"name": *"[^"]*"' "$meta_file" | sed 's/"name": *"\([^"]*\)"/\1/')
                local updated=$(grep -o '"updated": *"[^"]*"' "$meta_file" | sed 's/"updated": *"\([^"]*\)"/\1/')
                local node_count=$(find "$sub_dir" -name "*.json" ! -name "_meta.json" 2>/dev/null | wc -l)
                
                echo ""
                echo "Name: $name"
                echo "  Node count: $node_count"
                echo "  Updated: $updated"
                
                count=$((count + 1))
            done
            
            if [ "$count" -eq 0 ]; then
                echo ""
                echo "No subscriptions"
            fi
            echo ""
            ;;
        
        add)
            local name="${1:-}"
            local url="${2:-}"
            
            if [ -z "$name" ] || [ -z "$url" ]; then
                error "Usage: cli sub add <name> <URL>"
            fi
            
            info "Adding subscription: $name"
            sh "$SCRIPTS_DIR/config/subscription.sh" add "$name" "$url"
            ;;
        
        update)
            local name="${1:-}"
            
            if [ -z "$name" ]; then
                error "Usage: cli sub update <name>"
            fi
            
            info "Updating subscription: $name"
            sh "$SCRIPTS_DIR/config/subscription.sh" update "$name"
            ;;
        
        update-all)
            info "Updating all subscriptions..."
            sh "$SCRIPTS_DIR/config/subscription.sh" update-all
            ;;
        
        remove)
            local name="${1:-}"
            
            if [ -z "$name" ]; then
                error "Usage: cli sub remove <name>"
            fi
            
            info "Deleting subscription: $name"
            sh "$SCRIPTS_DIR/config/subscription.sh" remove "$name"
            ;;
        
        *)
            echo "Usage: cli sub <command>"
            echo ""
            echo "Commands:"
            echo "  list                List all subscriptions"
            echo "  add <name> <URL>    Add subscription"
            echo "  update <name>       Update the given subscription"
            echo "  update-all          Update all subscriptions"
            echo "  remove <name>       Delete subscription"
            ;;
    esac
}

#######################################
# Proxy settings
#######################################
cmd_proxy() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        mode)
            local new_mode="${1:-}"
            
            if [ -z "$new_mode" ]; then
                # View the current mode
                local mode="blacklist"
                if [ -f "$PROXY_CONF" ]; then
                    mode=$(grep -E "^proxy_mode=" "$PROXY_CONF" | cut -d'=' -f2 | tr -d ' \r')
                fi
                echo "Current proxy mode: $mode"
                echo ""
                echo "Mode descriptions:"
                echo "  blacklist - proxy all apps except those in the list"
                echo "  whitelist - proxy only the apps in the list"
            else
                # Set the mode
                case "$new_mode" in
                    blacklist|whitelist)
                        sed -i "s/proxy_mode=.*/proxy_mode=$new_mode/" "$PROXY_CONF"
                        info "Proxy mode set to: $new_mode"
                        
                        if is_running; then
                            info "Reloading proxy rules..."
                            sh "$SCRIPTS_DIR/network/tproxy.sh" renew
                            info "Rules applied"
                        else
                            info "Service is not running, takes effect on next start"
                        fi
                        ;;
                    *)
                        error "Invalid mode: $new_mode (options: blacklist, whitelist)"
                        ;;
                esac
            fi
            ;;
        
        apps)
            echo "=============================="
            echo "       Proxied App List"
            echo "=============================="
            
            local mode="blacklist"
            if [ -f "$PROXY_CONF" ]; then
                mode=$(grep -E "^proxy_mode=" "$PROXY_CONF" | cut -d'=' -f2 | tr -d ' \r')
            fi
            
            echo "Current mode: $mode"
            if [ "$mode" = "blacklist" ]; then
                echo "Note: the following apps bypass the proxy"
            else
                echo "Note: only the following apps are proxied"
            fi
            echo ""
            
            if [ -f "$APPS_LIST" ]; then
                local count=0
                while IFS= read -r line || [ -n "$line" ]; do
                    line=$(echo "$line" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                    [ -z "$line" ] && continue
                    case "$line" in \#*) continue ;; esac
                    
                    # Try to get the UID
                    local uid=$(awk -v pkg="$line" '$1==pkg {print $2}' /data/system/packages.list 2>/dev/null)
                    if [ -n "$uid" ]; then
                        echo "  $line (UID: $uid)"
                    else
                        echo "  $line"
                    fi
                    count=$((count + 1))
                done < "$APPS_LIST"
                
                if [ "$count" -eq 0 ]; then
                    echo "  (list is empty)"
                fi
            else
                echo "  (list file does not exist)"
            fi
            echo ""
            ;;
        
        add)
            local package="${1:-}"
            
            if [ -z "$package" ]; then
                error "Usage: cli proxy add <package>"
            fi
            
            # Check whether it already exists
            if [ -f "$APPS_LIST" ] && grep -q "^${package}$" "$APPS_LIST"; then
                warn "App is already in the list: $package"
                return 0
            fi
            
            # Verify that the package exists
            local uid=$(awk -v pkg="$package" '$1==pkg {print $2}' /data/system/packages.list 2>/dev/null)
            if [ -z "$uid" ]; then
                warn "App not found: $package (will still be added to the list)"
            fi
            
            echo "$package" >> "$APPS_LIST"
            info "Added app: $package"
            
            if is_running; then
                info "Reloading proxy rules..."
                sh "$SCRIPTS_DIR/network/tproxy.sh" renew
                info "Rules applied"
            fi
            ;;
        
        remove)
            local package="${1:-}"
            
            if [ -z "$package" ]; then
                error "Usage: cli proxy remove <package>"
            fi
            
            if [ ! -f "$APPS_LIST" ]; then
                error "App list file does not exist"
            fi
            
            if ! grep -q "^${package}$" "$APPS_LIST"; then
                warn "App is not in the list: $package"
                return 0
            fi
            
            sed -i "/^${package}$/d" "$APPS_LIST"
            info "Removed app: $package"
            
            if is_running; then
                info "Reloading proxy rules..."
                sh "$SCRIPTS_DIR/network/tproxy.sh" renew
                info "Rules applied"
            fi
            ;;
        
        reload)
            if ! is_running; then
                error "Service is not running"
            fi
            
            info "Reloading proxy rules..."
            sh "$SCRIPTS_DIR/network/tproxy.sh" renew
            info "Rules applied"
            ;;
        
        *)
            echo "Usage: cli proxy <command>"
            echo ""
            echo "Commands:"
            echo "  mode                Show proxy mode"
            echo "  mode <mode>         Set proxy mode (blacklist/whitelist)"
            echo "  apps                List proxied apps"
            echo "  add <package>       Add app to list"
            echo "  remove <package>    Remove app from list"
            echo "  reload              Reload proxy rules"
            ;;
    esac
}

#######################################
# Show help
#######################################
show_help() {
    cat << 'EOF'
NetProxy CLI - command-line control tool

Usage: adb shell su -c "/data/adb/modules/netproxy/scripts/cli <command> [args]"

Service control:
  status                  Show service status
  start                   Start service
  stop                    Stop service
  restart                 Restart service

Config management:
  config list             List all configs
  config switch <name>    Switch config (supports hot switch)
  config current          Show current config
  config add <link>       Add node
  config remove <name>    Delete config
  config show <name>      Show config contents

Subscription management:
  sub list                List all subscriptions
  sub add <name> <URL>    Add subscription
  sub update <name>       Update the given subscription
  sub update-all          Update all subscriptions
  sub remove <name>       Delete subscription

Proxy settings:
  proxy mode              Show proxy mode
  proxy mode <mode>       Set proxy mode (blacklist/whitelist)
  proxy apps              List proxied apps
  proxy add <package>     Add app to list
  proxy remove <package>  Remove app from list
  proxy reload            Reload proxy rules

Examples:
  # Service control
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli status"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli start"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli stop"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli restart"

  # Node management
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config list"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config add 'socks://user:pass@host:port#node-name'"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config add 'vless://uuid@host:port?...#node-name'"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config switch node-name.json"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config show node-name"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli config remove node-name"

  # Subscription management
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli sub list"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli sub add 'ProviderA' 'https://example.com/sub'"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli sub update 'ProviderA'"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli sub update-all"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli sub remove 'ProviderA'"

  # Proxy settings
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy mode"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy mode whitelist"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy mode blacklist"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy apps"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy add com.google.android.youtube"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy remove com.google.android.youtube"
  adb shell su -c "/data/adb/modules/netproxy/scripts/cli proxy reload"

EOF
}

#######################################
# Main program
#######################################
main() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    
    case "$cmd" in
        status)
            cmd_status
            ;;
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        config)
            cmd_config "$@"
            ;;
        sub|subscription)
            cmd_sub "$@"
            ;;
        proxy)
            cmd_proxy "$@"
            ;;
        -h|--help|help|"")
            show_help
            ;;
        *)
            error "Unknown command: $cmd\nUse '--help' for help"
            ;;
    esac
}

main "$@"
