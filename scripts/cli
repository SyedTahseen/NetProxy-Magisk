#!/system/bin/sh

set -e
set -u

MODDIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$MODDIR/scripts"
CONFIG_DIR="$MODDIR/config"
OUTBOUNDS_DIR="$CONFIG_DIR/xray/outbounds"
DEFAULT_GROUP_DIR="$OUTBOUNDS_DIR/default"
MODULE_CONF="$CONFIG_DIR/module.conf"
TPROXY_DIR="$CONFIG_DIR/tproxy"
TPROXY_CONF="$TPROXY_DIR/tproxy.conf"
SERVICE_SCRIPT="$SCRIPTS_DIR/core/service.sh"
XRAY_BIN="$MODDIR/bin/xray"

. "$SCRIPTS_DIR/utils/common.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() {
  printf "${GREEN}[INFO]${NC} %s\n" "$1"
}

warn() {
  printf "${YELLOW}[WARN]${NC} %s\n" "$1"
}

error() {
  printf "${RED}[ERROR]${NC} %s\n" "$1" >&2
  exit 1
}

get_pid() {
  pidof -s "$XRAY_BIN" 2> /dev/null || true
}

is_running() {
  [ -n "$(get_pid)" ]
}

current_config() {
  conf_get "$MODULE_CONF" "CURRENT_CONFIG"
}

find_config() {
  local name="$1" dir candidate
  for dir in "$DEFAULT_GROUP_DIR" "$OUTBOUNDS_DIR" "$OUTBOUNDS_DIR"/sub_*; do
    [ -d "$dir" ] || continue
    for candidate in "$dir/$name" "$dir/$name.json"; do
      if [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
      fi
    done
  done
  return 0
}

require_config() {
  local name="${1:-}" path
  [ -n "$name" ] || error "Please specify a config name"
  case "$name" in
    _meta | _meta.json) error "Not a node config: $name" ;;
  esac
  path=$(find_config "$name")
  [ -n "$path" ] || error "Config not found: $name"
  echo "$path"
}

print_config_entry() {
  local file="$1" current="$2" name
  name=$(basename "$file")
  if [ "$file" = "$current" ]; then
    printf "  ${GREEN}* %s${NC} (current)\n" "$name"
  else
    echo "    $name"
  fi
}

package_uid() {
  awk -v pkg="${1#*:}" '$1==pkg {print $2; exit}' /data/system/packages.list 2> /dev/null || true
}

app_list_key() {
  if [ "$(conf_get "$TPROXY_CONF" "APP_PROXY_MODE" "blacklist")" = "blacklist" ]; then
    echo "BYPASS_APPS_LIST"
  else
    echo "PROXY_APPS_LIST"
  fi
}

reload_rules() {
  if is_running; then
    info "Reloading proxy rules..."
    sh "$SERVICE_SCRIPT" reload-rules
    info "Rules applied"
  else
    info "Service is not running, takes effect on next start"
  fi
}

cmd_status() {
  echo "=============================="
  echo "       NetProxy Status"
  echo "=============================="

  local pid
  pid=$(get_pid)
  if [ -n "$pid" ]; then
    printf "Service status: ${GREEN}Running${NC}\n"
    echo "Process PID: $pid"
    echo "Uptime: $(ps -o etime= -p "$pid" 2> /dev/null | tr -d ' ' || echo "--")"

    local mem
    mem=$(ps -o rss= -p "$pid" 2> /dev/null | tr -d ' ' || echo "0")
    if [ "${mem:-0}" -gt 1024 ] 2> /dev/null; then
      echo "Memory usage: $((mem / 1024)) MB"
    else
      echo "Memory usage: ${mem:-0} KB"
    fi
  else
    printf "Service status: ${RED}Stopped${NC}\n"
  fi

  local config
  config=$(current_config)
  [ -n "$config" ] && echo "Current config: $(basename "$config")"

  echo "Outbound mode: $(conf_get "$MODULE_CONF" "OUTBOUND_MODE" "rule")"

  if [ -x "$XRAY_BIN" ]; then
    echo "Xray version: $("$XRAY_BIN" version 2> /dev/null | grep -o 'Xray [0-9.]*' | head -n 1 || echo "unknown")"
  fi

  echo "=============================="
}

cmd_start() {
  if is_running; then
    warn "Service is already running"
    return 0
  fi

  info "Starting service..."
  sh "$SERVICE_SCRIPT" start || true

  is_running || error "Service failed to start, please check the logs"
  info "Service started successfully"
}

cmd_stop() {
  if ! is_running; then
    warn "Service is not running"
    return 0
  fi

  info "Stopping service..."
  sh "$SERVICE_SCRIPT" stop || true

  ! is_running || error "Failed to stop service"
  info "Service stopped"
}

cmd_restart() {
  info "Restarting service..."
  sh "$SERVICE_SCRIPT" restart || true

  is_running || error "Failed to restart service"
  info "Service restarted successfully"
}

cmd_config() {
  local subcmd="${1:-}"
  shift 2> /dev/null || true

  case "$subcmd" in
    list)
      echo "=============================="
      echo "       Config File List"
      echo "=============================="

      local current f sub_dir
      current=$(current_config)

      echo ""
      echo "[Default group]"
      for f in "$DEFAULT_GROUP_DIR"/*.json; do
        [ -f "$f" ] || continue
        print_config_entry "$f" "$current"
      done

      for sub_dir in "$OUTBOUNDS_DIR"/sub_*; do
        [ -f "$sub_dir/_meta.json" ] || continue
        echo ""
        echo "[Subscription: $(json_field "$sub_dir/_meta.json" "name")]"
        for f in "$sub_dir"/*.json; do
          [ -f "$f" ] || continue
          [ "$(basename "$f")" = "_meta.json" ] && continue
          print_config_entry "$f" "$current"
        done
      done
      echo ""
      ;;

    switch)
      local config_path
      config_path=$(require_config "${1:-}")

      info "Switching config: $(basename "$config_path")"
      if is_running; then
        info "Service is running, performing hot switch..."
        sh "$SCRIPTS_DIR/core/switch-config.sh" "$config_path" || error "Hot switch failed"
        info "Hot switch complete"
      else
        conf_set "$MODULE_CONF" "CURRENT_CONFIG" "\"$config_path\""
        info "Config updated, takes effect on next start"
      fi
      ;;

    current)
      local config
      config=$(current_config)
      if [ -n "$config" ]; then
        echo "Current config: $(basename "$config")"
        echo "Full path: $config"
      else
        echo "No config set"
      fi
      ;;

    add)
      local node_link="${1:-}"
      [ -n "$node_link" ] || error "Please provide a node link"

      info "Parsing node link..."
      if sh "$SCRIPTS_DIR/utils/import-link.sh" "$node_link"; then
        info "Node added successfully"
      else
        error "Failed to add node"
      fi
      ;;

    add-wg)
      local wg_file="${1:-}"
      [ -n "$wg_file" ] || error "Usage: cli config add-wg <file.conf> [name]"
      [ -f "$wg_file" ] || error "File not found: $wg_file"

      info "Importing WireGuard config..."
      sh "$SCRIPTS_DIR/utils/import-wireguard.sh" "$wg_file" "${2:-}" || error "Failed to import WireGuard config"
      ;;

    remove)
      local config_path
      config_path=$(require_config "${1:-}")

      [ "$config_path" != "$(current_config)" ] || error "Cannot delete the config currently in use"

      rm -f "$config_path"
      info "Deleted config: $(basename "$config_path")"
      ;;

    show)
      local config_path
      config_path=$(require_config "${1:-}")

      echo "=============================="
      echo "Config: $(basename "$config_path")"
      echo "Path: $config_path"
      echo "=============================="
      cat "$config_path"
      ;;

    *)
      show_config_usage
      ;;
  esac
}

show_config_usage() {
  cat << 'EOF'
Usage: cli config <command>

Commands:
  list                List all configs
  switch <name>       Switch config (supports hot switch)
  current             Show current config
  add <node-link>     Add node (also: wireguard:// link or /path/to/wg.conf)
  add-wg <file.conf> [name]
                      Import a WireGuard (wg-quick) config
  remove <name>       Delete config
  show <name>         Show config contents
EOF
}

cmd_sub() {
  local subcmd="${1:-}"
  shift 2> /dev/null || true

  case "$subcmd" in
    list)
      sh "$SCRIPTS_DIR/config/subscription.sh" list
      ;;
    add)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || error "Usage: cli sub add <name> <URL>"
      info "Adding subscription: $1"
      sh "$SCRIPTS_DIR/config/subscription.sh" add "$1" "$2"
      ;;
    update)
      [ -n "${1:-}" ] || error "Usage: cli sub update <name>"
      info "Updating subscription: $1"
      sh "$SCRIPTS_DIR/config/subscription.sh" update "$1"
      ;;
    update-all)
      info "Updating all subscriptions..."
      sh "$SCRIPTS_DIR/config/subscription.sh" update-all
      ;;
    remove)
      [ -n "${1:-}" ] || error "Usage: cli sub remove <name>"
      info "Deleting subscription: $1"
      sh "$SCRIPTS_DIR/config/subscription.sh" remove "$1"
      ;;
    *)
      cat << 'EOF'
Usage: cli sub <command>

Commands:
  list                List all subscriptions
  add <name> <URL>    Add subscription
  update <name>       Update the given subscription
  update-all          Update all subscriptions
  remove <name>       Delete subscription
EOF
      ;;
  esac
}

cmd_proxy() {
  local subcmd="${1:-}"
  shift 2> /dev/null || true

  case "$subcmd" in
    mode)
      local new_mode="${1:-}"
      if [ -z "$new_mode" ]; then
        echo "Current proxy mode: $(conf_get "$TPROXY_CONF" "APP_PROXY_MODE" "blacklist")"
        echo ""
        echo "Mode descriptions:"
        echo "  blacklist - proxy all apps except those in the list"
        echo "  whitelist - proxy only the apps in the list"
      else
        case "$new_mode" in
          blacklist | whitelist) ;;
          *) error "Invalid mode: $new_mode (options: blacklist, whitelist)" ;;
        esac
        conf_set "$TPROXY_CONF" "APP_PROXY_MODE" "\"$new_mode\""
        info "Proxy mode set to: $new_mode"
        reload_rules
      fi
      ;;

    apps)
      local mode key pkg uid
      mode=$(conf_get "$TPROXY_CONF" "APP_PROXY_MODE" "blacklist")
      key=$(app_list_key)

      echo "=============================="
      echo "       Proxied App List"
      echo "=============================="
      echo "Current mode: $mode"
      if [ "$mode" = "blacklist" ]; then
        echo "Note: the following apps bypass the proxy"
      else
        echo "Note: only the following apps are proxied"
      fi
      [ "$(conf_get "$TPROXY_CONF" "APP_PROXY_ENABLE" "0")" = "1" ] || warn "Per-app proxy is disabled (APP_PROXY_ENABLE=0)"
      echo ""

      local apps count=0
      apps=$(conf_get "$TPROXY_CONF" "$key")
      for pkg in $apps; do
        uid=$(package_uid "$pkg")
        if [ -n "$uid" ]; then
          echo "  $pkg (UID: $uid)"
        else
          echo "  $pkg"
        fi
        count=$((count + 1))
      done
      [ "$count" -gt 0 ] || echo "  (list is empty)"
      echo ""
      ;;

    add)
      local package="${1:-}" key apps
      [ -n "$package" ] || error "Usage: cli proxy add <package>"
      key=$(app_list_key)
      apps=$(conf_get "$TPROXY_CONF" "$key")

      case " $apps " in
        *" $package "*)
          warn "App is already in the list: $package"
          return 0
          ;;
      esac

      if [ -z "$(package_uid "$package")" ]; then
        warn "App not found: $package (will still be added to the list)"
      fi

      conf_set "$TPROXY_CONF" "$key" "\"${apps:+$apps }$package\""
      info "Added app: $package"
      reload_rules
      ;;

    remove)
      local package="${1:-}" key apps remaining="" pkg
      [ -n "$package" ] || error "Usage: cli proxy remove <package>"
      key=$(app_list_key)
      apps=$(conf_get "$TPROXY_CONF" "$key")

      case " $apps " in
        *" $package "*) ;;
        *)
          warn "App is not in the list: $package"
          return 0
          ;;
      esac

      for pkg in $apps; do
        [ "$pkg" = "$package" ] || remaining="${remaining:+$remaining }$pkg"
      done
      conf_set "$TPROXY_CONF" "$key" "\"$remaining\""
      info "Removed app: $package"
      reload_rules
      ;;

    reload)
      is_running || error "Service is not running"
      reload_rules
      ;;

    *)
      cat << 'EOF'
Usage: cli proxy <command>

Commands:
  mode                Show proxy mode
  mode <mode>         Set proxy mode (blacklist/whitelist)
  apps                List proxied apps
  add <package>       Add app to list
  remove <package>    Remove app from list
  reload              Reload proxy rules
EOF
      ;;
  esac
}

show_help() {
  cat << 'EOF'
NetProxy CLI - command-line control tool

Usage: adb shell su -c "/data/adb/modules/netproxy/scripts/cli <command> [args]"

Service control:
  status                  Show service status
  start                   Start service
  stop                    Stop service
  restart                 Restart service

Config management:
  config list             List all configs
  config switch <name>    Switch config (supports hot switch)
  config current          Show current config
  config add <link>       Add node (link, wireguard:// or /path/to/wg.conf)
  config add-wg <file> [name]  Import WireGuard (wg-quick) .conf
  config remove <name>    Delete config
  config show <name>      Show config contents

Subscription management:
  sub list                List all subscriptions
  sub add <name> <URL>    Add subscription
  sub update <name>       Update the given subscription
  sub update-all          Update all subscriptions
  sub remove <name>       Delete subscription

Per-app proxy settings:
  proxy mode              Show proxy mode
  proxy mode <mode>       Set proxy mode (blacklist/whitelist)
  proxy apps              List apps of the current mode
  proxy add <package>     Add app to the current mode's list
  proxy remove <package>  Remove app from the current mode's list
  proxy reload            Reload proxy rules

Examples:
  cli status
  cli config add 'vless://uuid@host:port?...#node-name'
  cli config add-wg /sdcard/Download/wg0.conf my-wireguard
  cli config switch node-name.json
  cli sub add 'ProviderA' 'https://example.com/sub'
  cli proxy mode whitelist
  cli proxy add com.google.android.youtube
EOF
}

main() {
  local cmd="${1:-}"
  shift 2> /dev/null || true

  case "$cmd" in
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    config) cmd_config "$@" ;;
    sub | subscription) cmd_sub "$@" ;;
    proxy) cmd_proxy "$@" ;;
    -h | --help | help | "") show_help ;;
    *)
      printf "${RED}[ERROR]${NC} Unknown command: %s\nUse 'help' for usage\n" "$cmd" >&2
      exit 1
      ;;
  esac
}

main "$@"
